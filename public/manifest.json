{
  "name": "ViceLink // Leonida Companion Hub",
  "short_name": "ViceLink",
  "description": "Private member utility hub for Leonida: cheat codes, interactive map, sandbox patch tracker, economy planner, and AI mission advisor.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#05070e",
  "theme_color": "#00e5ff",
  "categories": ["games", "entertainment", "utilities"],
  "share_target": {
    "action": "/api/share-sync",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "image",
          "accept": ["image/png", "image/jpeg", "image/webp"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
